# Copy this file to .env and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard). The EXPO_PUBLIC_
# prefix is required for Expo to inline these into the app bundle — never
# put a secret/service-role key behind this prefix, only the public anon key.
#
# See docs/SUPABASE_SETUP.md for the full setup walkthrough.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
